<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom URL scheme: weightcutwizard:// (OAuth callback + in-app routes) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="weightcutwizard" />
            </intent-filter>

            <!-- App Links: https://fightcampwizard.com (requires hosted assetlinks.json) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="fightcampwizard.com" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: meal/training photos + barcode scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The CAMERA permission implicitly marks the camera hardware (and
         autofocus) as a REQUIRED feature, which makes Google Play filter the
         app off any device that doesn't report a rear autofocus camera
         ("device not compatible"). Declare them as NOT required so the app is
         available to all devices; the app checks for a camera at runtime. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Hardware features that other permissions / the Credential Manager
         dependency (Google Sign-In) implicitly mark as REQUIRED, which silently
         filters the app off large numbers of devices on Google Play. Declare
         them all NOT required so the app reaches the maximum device set; the app
         degrades gracefully at runtime when a feature is absent.
         - fingerprint: USE_BIOMETRIC/USE_FINGERPRINT (Credential Manager) would
           exclude every phone/tablet without a fingerprint sensor (e.g. budget
           Galaxy A-series, many tablets, face-unlock-only devices).
         - vibration: the VIBRATE permission would exclude devices with no motor.
         - touchscreen: implicitly required by default; excludes Chromebooks /
           non-touch Android devices. -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.vibration" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Push (FCM) + local notification posting on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Haptics / vibrate -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Media read: photo/video picking (Android 13+ granular media perms) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Older devices (Android 12L and below) fall back to legacy storage read -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>
